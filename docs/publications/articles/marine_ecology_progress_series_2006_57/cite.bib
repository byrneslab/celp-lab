  title = {Species diversity, invasion success, and ecosystem functioning: disentangling the influence of resource competition, facilitation, and extrinsic factors},
  year = {2006},
  jrnl_short = {marine_ecology_progress_series},
  author = {John J Stachowicz and Jarrett E Byrnes},
