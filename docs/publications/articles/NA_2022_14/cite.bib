  jrnl_short = {none},
  author = {Jarrett Edward Kaplan Byrnes and Andrea Brown and Kate Sheridan and Tianna Peller and Jake Lawlor and Julien Beaulieu and Jenny Mu{\~n}oz-Z and Amelia Hesketh and Alexis Pereira and Nicole S. Knight},
  journal = {none},
