  jrnl_short = {nature_communications},
  author = {Aaron M. Eger and Ezequiel M. Marzinelli and Rodrigo Beas-Luna and Caitlin O. Blain and Laura K. Blamey and Jarrett E. K. Byrnes and Paul E. Carnell and Chang Geun Choi and Margot Hessing-Lewis and Kwang Young Kim and Naoki H. Kumagai and Julio Lorda and Pippa Moore and Yohei Nakamura and Alejandro P{\a'e}rez-Matus and Ondine Pontier and Dan Smale and Peter D. Steinberg and Adriana Verg{\a'e}s},
  journal = {Nature Communications},
