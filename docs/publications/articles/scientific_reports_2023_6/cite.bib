  title = {Evidence of elevated heavy metals concentrations in wild and farmed sugar kelp (Saccharina latissima) in New England},
  year = {2023},
  jrnl_short = {scientific_reports},
  author = {Brianna K. Shaughnessy and Brian P. Jackson and Jarrett E. K. Byrnes},
  journal = {Scientific Reports},
  volume = {13},
  number = {1},
