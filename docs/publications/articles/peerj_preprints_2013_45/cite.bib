  rowid.y = {45},
  title = {The sea urchin – the ultimate herbivore and biogeographic variability in its ability to deforest kelp ecosystems},
  year = {2013},
  jrnl_short = {peerj_preprints},
  author = {Jarrett E Byrnes and Ladd E. Johnson and Sean D. Connell and Nick T. Shears and Selena M McMillan and Andrew Irving and Alejandro H Buschmann and Michael H. Graham and Brian P. Kinlan},
  journal = {PeerJ PrePrints},
