  rowid.y = {26},
  title = {Invasions and extinctions reshape coastal marine food webs.},
  year = {2007},
  jrnl_short = {plos_one},
  author = {Jarrett E Byrnes and Pamela L Reynolds and John J Stachowicz},
  journal = {PloS one},
