  title = {Effects of predator richness on prey suppression: a meta-analysis},
  year = {2013},
  jrnl_short = {ecology},
  author = {John N. Griffin and Jarrett E K Byrnes and Bradley J Cardinale},
  journal = {Ecology},
  volume = {94},
  number = {10},
